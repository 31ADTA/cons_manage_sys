#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Executable Script
# ----------------------------------------------------------------------------

set -e

PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/$link"
  fi
done
BASE_DIR=`dirname "$PRG"`

if [ -z "$JAVA_HOME" ]; then
  if [ -x '/usr/libexec/java_home' ]; then
    JAVA_HOME=`/usr/libexec/java_home 2>/dev/null || true`
  fi
  if [ -z "$JAVA_HOME" ] && [ -d "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home" ]; then
    JAVA_HOME="/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
  fi
fi

if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_PROPERTIES="$WRAPPER_DIR/maven-wrapper.properties"

# Download wrapper jar if missing
if [ ! -f "$WRAPPER_JAR" ]; then
  mkdir -p "$WRAPPER_DIR"
  WRAPPER_URL=""
  if [ -f "$WRAPPER_PROPERTIES" ]; then
    WRAPPER_URL=$(grep -E "^wrapperUrl=" "$WRAPPER_PROPERTIES" | cut -d'=' -f2- | tr -d '\r')
  fi
  if [ -z "$WRAPPER_URL" ]; then
    WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  fi

  if command -v curl >/dev/null 2>&1; then
    echo "Downloading Maven Wrapper JAR from $WRAPPER_URL..."
    curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_URL" || true
  fi
fi

# Fallback to global maven if wrapper jar cannot be obtained or run
if [ ! -f "$WRAPPER_JAR" ]; then
  if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
  else
    echo "Error: maven-wrapper.jar could not be found or downloaded, and 'mvn' is not installed." >&2
    echo "Please ensure an internet connection is available or install Apache Maven." >&2
    exit 1
  fi
fi

exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
